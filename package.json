{
  "name": "cctv-h5e-decrypt",
  "version": "0.0.1",
  "description": "Decrypt CCTV h5e-encrypted videos",
  "type": "module",
  "homepage": "https://github.com/xiaoxi-ij478/cctv-h5e-decrypt#readme",
  "bugs": {
    "url": "https://github.com/xiaoxi-ij478/cctv-h5e-decrypt/issues"
  },
  "files": [
    "build"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoxi-ij478/cctv-h5e-decrypt.git"
  },
  "license": "MIT",
  "author": "xiaoxi-ij478",
  "main": "./build/decrypt.js",
  "types": "./build/decrypt.d.ts",
  "exports": {
    ".": {
      "import": "./build/decrypt.js",
      "types": "./build/decrypt.d.ts"
    }
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "rm -rf build && tsc && rm -f build/external/*.map && diff src/external/cctv.worker.js ~/cctv.worker.orig.js -u >src/external/cctv.worker.diff",
    "bundle": "esbuild src/main.ts --sourcemap=external --bundle --platform=node --format=esm --outfile=build/final/final.js"
  },
  "dependencies": {
    "js-crc": "^0.3.1"
  },
  "devDependencies": {
    "@types/js-crc": "^0.2.3",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.4"
  },
  "allowScripts": {
    "esbuild@0.28.0": true
  }
}
